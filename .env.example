# GitHub webhook secret — set this when creating the webhook in GitHub repo settings
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# GitHub personal access token (needs repo + issues scope)
# Find: github.com/settings/tokens → Generate new token → check repo, public_repo
GITHUB_TOKEN=ghp_your-token-here

# Linear API key
# Find: linear.app/settings/api → Personal API keys → Create key
LINEAR_API_KEY=lin_api_your-key-here

# Linear team ID (the team where issues will be created)
# Find: linear.app/YOUR_ORG/settings/teams → click your team → copy ID from URL
LINEAR_TEAM_ID=your-team-id-here

# Anthropic API key (for pydantic-ai triage classifier)
ANTHROPIC_API_KEY=sk-ant-your-key-here
